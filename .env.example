# VHS installation (docs/installation.md): copy to .env and adjust the values marked below.
# For development use .env.dev.example instead.

# --- Required -----------------------------------------------------------------------------

# A long random string: openssl rand -base64 48
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false

# Names and addresses used to open VHS in the browser.
DJANGO_ALLOWED_HOSTS=vhs.lan,192.168.1.50

# Database password: choose a strong one.
POSTGRES_PASSWORD=change-me

# The video library: a folder on this server's own disk, created beforehand and owned by
# uid 1000 (sudo mkdir -p /srv/vhs/library && sudo chown 1000:1000 /srv/vhs/library).
VHS_HOST_LIBRARY=/srv/vhs/library

# Compose files: with this line every command is simply "docker compose ...".
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- HTTP or HTTPS: keep ONE of the two blocks ----------------------------------------------

# HTTP on a trusted local network (active). Login password and session cookie travel
# UNENCRYPTED: anyone watching the network can read them. Without this line (default true)
# the browser does not send the Secure cookies back over HTTP and the login fails.
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://vhs.lan,http://192.168.1.50

# HTTPS (recommended when possible): delete the two lines above, uncomment the two lines
# below and put the certificate and its key in the certs folder, as fullchain.pem and
# privkey.pem (docs/installation.md).
# VHS_HTTPS=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://vhs.lan

# --- Optional (defaults shown) ---------------------------------------------------------------

# Library layout: standard | tvshow
# VHS_NAMING_TEMPLATE=standard
# Free space always kept on the library (bytes), stall warning threshold (seconds)
# VHS_MIN_FREE_BYTES=1073741824
# VHS_DOWNLOAD_STALL_SECONDS=300
# Concurrent downloads and conversions
# VHS_WORKERS=2
# Browser copies (transcoding runs only on request)
# VHS_TRANSCODE_PRESET=veryfast
# VHS_TRANSCODE_CRF=21
# VHS_TRANSCODE_AUDIO_BITRATE=160k
# VHS_LOG_LEVEL=INFO
# Time zone used to display times, e.g. Europe/Rome (stored times are always UTC)
# VHS_TIME_ZONE=UTC
# Ask GitHub, at most twice a day, whether a newer VHS release exists (shown on the Home page)
# VHS_UPDATE_CHECK=true
# Emergency only: install the latest yt-dlp at every start, a version not tested with VHS
# (docs/installation.md, "Troubleshooting")
# VHS_YTDLP_AUTO_UPDATE=false
