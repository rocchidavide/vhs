# Development only (docker-compose.dev.yml): Vite dev server with the frontend code mounted.
FROM node:24-alpine

# node_modules lives in a named volume: create the mount point owned by "node" (uid 1000) so
# that the new volume inherits that owner instead of root.
RUN mkdir -p /app/frontend/node_modules && chown -R node:node /app

USER node
WORKDIR /app/frontend
EXPOSE 5173
