# VHS development (docs/development.md): cp .env.dev.example .env
# Everything runs in containers: docker-compose.yml plus the docker-compose.dev.yml override.
# For an installation use .env.example instead: never this file.

# Plain "docker compose ..." commands act on the development environment.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Django (development only: DEBUG on, plain HTTP on localhost)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8081

# PostgreSQL (in the db container)
POSTGRES_DB=vhs
POSTGRES_USER=vhs
POSTGRES_PASSWORD=vhs

# Video library of the development environment, mounted as /srv/video-library.
VHS_HOST_LIBRARY=./video-library

# Development address: http://localhost:8081 (loopback only)
VHS_DEV_HTTP_PORT=8081

# Linux: your user and group ids, if not 1000 (id -u, id -g), so that files created in the
# mounted repository stay yours.
# VHS_UID=1000
# VHS_GID=1000

# Worker (seconds); VHS_TASK_RETRY must exceed VHS_TASK_TIMEOUT.
VHS_WORKERS=2
VHS_TASK_TIMEOUT=21600
VHS_TASK_RETRY=22500
VHS_LOG_LEVEL=INFO
